{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trends-agent",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "trends-agent-offline",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY=offline",
        "npm", "run", "dev", "--", "-p", "3001"
      ],
      "port": 3001
    }
  ]
}
